# Supabase - Base de datos y autenticacion
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Web Push - Claves VAPID (Generar con: npx web-push generate-vapid-keys). Sin ellas no se envía ningún aviso.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu_clave_publica_vapid
VAPID_PRIVATE_KEY=tu_clave_privada_vapid
# Para cambiar de clave sin cortar las alertas: el par nuevo va aquí; conviven las dos hasta retirar la anterior
# (ver lib/push-service.ts).
# VAPID_PUBLIC_KEY_V2=
# VAPID_PRIVATE_KEY_V2=
VAPID_SUBJECT=mailto:alerta@sismopanama.com

# Cron de seguridad (Bearer Token para /api/cron/check-quakes)
CRON_SECRET=tu_clave_secreta_para_el_cron

# URL del sitio (Opcional, por defecto usa https://www.ojopanama.com)
NEXT_PUBLIC_SITE_URL=https://www.ojopanama.com

# Reportes «¿Lo sentiste?»: clave para cifrar (HMAC) el identificador del dispositivo y de la conexión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REPORTS_SECRET=tu_clave_secreta_para_reportes
